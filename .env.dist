# Slack MCP Server — Environment Variables
# Copy this to .env and fill in your values.

# At least one token is required:
SLACK_MCP_BOT_TOKEN=
SLACK_MCP_USER_TOKEN=
SLACK_MCP_XOXC_TOKEN=
SLACK_MCP_XOXD_TOKEN=

# Optional workspace config
SLACK_TEAM_ID=
SLACK_CHANNEL_IDS=
SLACK_MCP_DEFAULT_CHANNEL=

# Transport settings
SLACK_MCP_PORT=3000
SLACK_MCP_HOST=127.0.0.1
SLACK_MCP_API_KEY=

# Network / Enterprise
SLACK_MCP_PROXY=
SLACK_MCP_USER_AGENT=
SLACK_MCP_CUSTOM_TLS=false
SLACK_MCP_SERVER_CA=
SLACK_MCP_SERVER_CA_INSECURE=false
SLACK_MCP_GOVSLACK=false
SLACK_MCP_TIMEOUT_MS=30000

# Tool controls
SLACK_MCP_MAX_RESULTS=100
SLACK_MCP_ADD_MESSAGE_TOOL=
SLACK_MCP_ADD_MESSAGE_MARK=false
SLACK_MCP_ADD_MESSAGE_UNFURLING=
SLACK_MCP_REACTION_TOOL=
SLACK_MCP_ATTACHMENT_TOOL=
SLACK_MCP_MARK_TOOL=
SLACK_MCP_CANVAS_TOOL=
SLACK_MCP_ENABLED_TOOLS=

# Cache
SLACK_MCP_USERS_CACHE=
SLACK_MCP_CHANNELS_CACHE=
SLACK_MCP_CACHE_TTL=24h
SLACK_MCP_MIN_REFRESH_INTERVAL=30s

# Logging
SLACK_MCP_LOG_LEVEL=info
