{
  "name": "@fazorboy/slack-mcp-server",
  "version": "0.1.1",
  "description": "MCP server for Slack — send messages, manage channels, search conversations, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "slack-mcp-server": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bhayanak/slack-mcp-server"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "ci": "tsc --noEmit && eslint src/ test/ && vitest run --coverage && prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": ["mcp", "slack", "ai", "model-context-protocol"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@slack/web-api": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^3.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
